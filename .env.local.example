# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key (Project Settings -> API -> Legacy API Keys, or the new
# "secret" key). Server-only — NEVER expose this to the browser. Used only
# by the Stripe webhook to write purchase results after payment succeeds.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: pokemontcg.io API key (raises the rate limit from 30 to 20000
# requests/day, and is noticeably more reliable). Get one free at
# https://dev.pokemontcg.io/
POKEMONTCG_API_KEY=

# Stripe (test mode keys to start — see README for setup). Powers the paid
# "auto-populate a master set" feature.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price per auto-populate, in cents. Pick your real price before going live.
MASTERSET_AUTOPOPULATE_PRICE_CENTS=299

# Base URL this app is served from — used to build Stripe checkout redirect
# URLs. http://localhost:3000 for local dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000
